      ],
      "summary": "An Express and Drizzle authentication API with PostgreSQL-backed sessions and server-side logout.",
      "description": "The API supports registration, login, logout, and viewing, updating, or deleting an account. Request validation checks the inputs before account changes, and bcrypt hashes passwords.\n\nOn login the API creates a UUID session token in PostgreSQL and sends it in an HTTP-only cookie. The auth middleware checks that session for protected requests. Logging out deletes the database session and clears the cookie.",
      "links": [
        {
          "type": "github",
          "href": "https://github.com/BeyondV0id/drizzle-auth-api"
        }
      ],
      "isExpanded": true
