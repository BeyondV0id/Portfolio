    {
      "id": "quorum",
      "symbol": "discussion",
      "title": "Quorum",
      "image": "",
      "pinned": true,
      "skills": [
        "React",
        "TypeScript",
        "Node.js",
        "Express",
        "PostgreSQL",
        "Drizzle ORM",
        "Better Auth",
        "Docker"
      ],
      "summary": "A developer Q&A platform with topic spaces, threaded replies, voting, accepted answers, and notifications.",
      "description": "Quorum is a Q&A platform where users create topic spaces, post questions, reply, upvote, and accept answers. Mentions generate notifications, and Better Auth supports sign-in with GitHub or Google.\n\nPosting, replying, and voting use PostgreSQL transactions so counter updates and notification writes commit together. A composite unique index prevents duplicate notifications. Zod validates incoming data, and authorization checks limit edits, deletions, and pinning to users who own the content.",
      "links": [
        {
          "type": "github",
          "href": "https://github.com/BeyondV0id/Quorum"
        },
        {
          "type": "website",
          "href": "https://quorum-io.vercel.app/"
        }
      ],
      "isExpanded": true
    },
    {
      "id": "chronos",
      "symbol": "data",
      "title": "Chronos",
      "skills": [
        "TypeScript",
        "Node.js",
        "Express",
        "Redis",
        "Lua",
        "Docker",
        "k6"
      ],
      "summary": "A distributed job scheduler with delayed and recurring jobs, priority queues, and recovery after worker crashes.",
      "description": "Chronos schedules delayed, cron, and priority jobs in Redis. Failed jobs retry with exponential backoff and move to a dead-letter queue after retries are exhausted.\n\nAtomic Lua scripts and a visibility-timeout reaper recover jobs claimed by crashed workers for at-least-once delivery. Per-tenant token buckets prevent one tenant's traffic from starving others, and idempotency keys prevent client retries from creating duplicate jobs.\n\nLoad tests measured throughput above 5,000 jobs per second. Chaos tests recorded zero job loss."
    },
    {
      "id": "oss-trends-scraper",
      "symbol": "data",
      "title": "OSS Trends Scraper",
      "image": "",
